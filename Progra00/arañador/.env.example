# Copia este archivo a .env y ajusta lo necesario.
# Raíz de datos compartida: '..' apunta a Progra00/, donde las dos
# implementaciones comparten almacenamiento/ (BD + repositorio) y resultados/.
RAIZ_DATOS=..
USER_AGENT="AranadorAudiovisualBot/1.0 (+https://tec.ac.cr/ic8060)"
# Semillas compartidas por ambas implementaciones (Progra00/semillas.txt).
SEMILLAS=../semillas.txt
# El detalle por intento vive en la tabla bitacora_recorrido; el log de texto
# se deja en WARNING para no crecer con una línea por petición.
LOG_LEVEL=WARNING
LOG_FILE=bitacoras/cosecha.log
INTERVALO_PROGRESO=15
OBJETIVO_GIB=10
# Procesos para el conteo de Zipf; 0 o vacío = automático (hasta 8).
TRABAJADORES_ZIPF=0
