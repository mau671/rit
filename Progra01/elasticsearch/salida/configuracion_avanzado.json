{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "codec": "default",
    "refresh_interval": "-1",
    "analyze.max_token_count": 1000000,
    "similarity": {
      "tfidf_propio": {
        "type": "scripted",
        "weight_script": {
          "source": "double idf = (((double) term.docFreq) > 0 ? Math.log(((double) field.docCount) / ((double) term.docFreq) + 1.0) : 0.0); return query.boost * idf;"
        },
        "script": {
          "source": "double idf = (((double) term.docFreq) > 0 ? Math.log(((double) field.docCount) / ((double) term.docFreq) + 1.0) : 0.0); return weight * (doc.freq > 0 ? 1.0 + Math.log(doc.freq) : 0.0) * idf;"
        }
      }
    },
    "analysis": {
      "char_filter": {
        "nfkc": {
          "type": "icu_normalizer",
          "name": "nfkc",
          "mode": "compose"
        },
        "tipografia": {
          "type": "mapping",
          "mappings": [
            "’ => \\u0027",
            "‘ => \\u0027",
            "` => \\u0027",
            "“ => \\u0022",
            "” => \\u0022",
            "« => \\u0022",
            "» => \\u0022",
            "— => \\u0020-\\u0020",
            "– => \\u0020-\\u0020"
          ]
        },
        "fechas": {
          "type": "pattern_replace",
          "pattern": "(?<![\\p{L}\\p{N}_])(?:\\p{Nd}{1,2}[/-]\\p{Nd}{1,2}[/-](?:18|19|20)\\p{Nd}{2}|(?:18|19|20)\\p{Nd}{2}[/-]\\p{Nd}{1,2}[/-]\\p{Nd}{1,2})(?![\\p{L}\\p{N}_])",
          "replacement": " <FECHA> ",
          "flags": "UNICODE_CHARACTER_CLASS"
        },
        "fechas_textuales": {
          "type": "pattern_replace",
          "pattern": "(?<![\\p{L}\\p{N}_])\\p{Nd}{1,2}\\s+de\\s+(?:enero|febrero|marzo|abril|mayo|junio|julio|agosto|septiembre|setiembre|octubre|noviembre|diciembre)\\s+de(?:l)?\\s+(?:18|19|20)\\p{Nd}{2}(?![\\p{L}\\p{N}_])|(?<![\\p{L}\\p{N}_])(?:january|february|march|april|may|june|july|august|september|october|november|december)\\s+\\p{Nd}{1,2}(?:st|nd|rd|th)?,?\\s+(?:18|19|20)\\p{Nd}{2}(?![\\p{L}\\p{N}_])|(?<![\\p{L}\\p{N}_])\\p{Nd}{1,2}(?:st|nd|rd|th)?\\s+(?:of\\s+)?(?:january|february|march|april|may|june|july|august|september|october|november|december),?\\s+(?:18|19|20)\\p{Nd}{2}(?![\\p{L}\\p{N}_])",
          "replacement": " <FECHA> ",
          "flags": "CASE_INSENSITIVE|UNICODE_CHARACTER_CLASS"
        },
        "anios": {
          "type": "pattern_replace",
          "pattern": "(?<![\\p{L}\\p{N}_])(188[89]|189\\p{Nd}|19\\p{Nd}{2}|20\\p{Nd}{2})(?![\\p{L}\\p{N}_])",
          "replacement": " <ANIO_$1> ",
          "flags": "UNICODE_CHARACTER_CLASS"
        },
        "numeros": {
          "type": "pattern_replace",
          "pattern": "(?<![\\p{L}\\p{N}_])\\p{Nd}+(?:[.,]\\p{Nd}+)?(?![\\p{L}\\p{N}_])",
          "replacement": " <NUM> ",
          "flags": "UNICODE_CHARACTER_CLASS"
        }
      },
      "tokenizer": {
        "tokens_propio": {
          "type": "pattern",
          "pattern": "<[A-Z0-9_]+>|[\\p{L}\\p{N}]+(?:[-'_][\\p{L}\\p{N}]+)*",
          "group": 0,
          "flags": "UNICODE_CHARACTER_CLASS"
        }
      },
      "filter": {
        "i_turca": {
          "type": "pattern_replace",
          "pattern": "İ",
          "replacement": "i̇"
        },
        "marcador_fecha": {
          "type": "pattern_replace",
          "pattern": "^<fecha>$",
          "replacement": "<FECHA>"
        },
        "marcador_num": {
          "type": "pattern_replace",
          "pattern": "^<num>$",
          "replacement": "<NUM>"
        },
        "marcador_anio": {
          "type": "pattern_replace",
          "pattern": "^<anio_(\\d{4})>$",
          "replacement": "<ANIO_$1>"
        },
        "proteger_ene": {
          "type": "pattern_replace",
          "pattern": "ñ",
          "replacement": ""
        },
        "proteger_ene_may": {
          "type": "pattern_replace",
          "pattern": "Ñ",
          "replacement": ""
        },
        "sin_acentos": {
          "type": "icu_transform",
          "id": "NFKD; [:Nonspacing Mark:] Remove; NFC"
        },
        "restaurar_ene": {
          "type": "pattern_replace",
          "pattern": "",
          "replacement": "ñ"
        },
        "restaurar_ene_may": {
          "type": "pattern_replace",
          "pattern": "",
          "replacement": "Ñ"
        },
        "cliticos": {
          "type": "pattern_replace",
          "pattern": "'(?:s|re|ve|ll|d|m)$",
          "replacement": ""
        },
        "longitud": {
          "type": "length",
          "min": 2,
          "max": 50
        },
