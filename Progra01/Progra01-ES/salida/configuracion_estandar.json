{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "codec": "default",
    "refresh_interval": "-1",
    "analyze.max_token_count": 1000000,
    "similarity": {
      "tfidf_propio": {
        "type": "scripted",
        "weight_script": {
          "source": "double idf = (((double) term.docFreq) > 0 ? Math.log(((double) field.docCount) / ((double) term.docFreq) + 1.0) : 0.0); return query.boost * idf;"
        },
        "script": {
          "source": "double idf = (((double) term.docFreq) > 0 ? Math.log(((double) field.docCount) / ((double) term.docFreq) + 1.0) : 0.0); return weight * (doc.freq > 0 ? 1.0 + Math.log(doc.freq) : 0.0) * idf;"
        }
      }
    },
    "analysis": {
      "char_filter": {
        "nfkc": {
          "type": "icu_normalizer",
          "name": "nfkc",
          "mode": "compose"
        },
        "tipografia": {
          "type": "mapping",
          "mappings": [
            "’ => \\u0027",
            "‘ => \\u0027",
            "` => \\u0027",
            "“ => \\u0022",
            "” => \\u0022",
            "« => \\u0022",
            "» => \\u0022",
            "— => \\u0020-\\u0020",
            "– => \\u0020-\\u0020"
          ]
        }
      },
      "tokenizer": {
        "tokens_propio": {
          "type": "pattern",
          "pattern": "<[A-Z0-9_]+>|[^\\W_]+(?:[-'_][^\\W_]+)*",
          "group": 0,
          "flags": "UNICODE_CHARACTER_CLASS"
        }
      },
