      },
      "idioma": {
        "type": "keyword"
      },
      "tamano_bytes": {
        "type": "integer"
      },
      "norma": {
        "type": "float"
      },
      "contenido_es": {
        "type": "text",
        "analyzer": "politica_es",
        "similarity": "tfidf_propio",
        "index_options": "freqs",
        "norms": false
      },
      "contenido_en": {
        "type": "text",
        "analyzer": "politica_en",
        "similarity": "tfidf_propio",
